# Example command policy for the opt-in `:power-user` permission profile.
#
# These rules intentionally keep routine local development low-friction while
# prompting at trust boundaries and forbidding known-catastrophic operations.

prefix_rule(
    pattern = ["pwd"],
    decision = "allow",
    justification = "Read-only workspace inspection is safe to run without prompting.",
)

prefix_rule(
    pattern = [["ls", "rg", "find", "sed", "head", "tail", "wc"]],
    decision = "allow",
    justification = "Read-only workspace inspection is safe to run without prompting.",
)

prefix_rule(
    pattern = ["git", ["status", "diff", "log", "show", "branch"]],
    decision = "allow",
    justification = "Read-only git inspection is safe to run without prompting.",
)

prefix_rule(
    pattern = [["cargo", "npm", "pnpm", "yarn", "uv", "pytest"], ["test", "run", "build", "check", "fmt", "clippy"]],
    decision = "allow",
    justification = "Routine tests, builds, and format checks are safe inside the workspace sandbox.",
)

prefix_rule(
    pattern = [["npm", "pnpm", "yarn"], ["install", "add", "remove", "update", "upgrade"]],
    decision = "prompt",
    justification = "Dependency changes can run lifecycle scripts or alter lockfiles; ask first.",
)

prefix_rule(
    pattern = ["uv", ["add", "remove", "sync", "lock"]],
    decision = "prompt",
    justification = "Dependency changes can reach package indexes or alter lockfiles; ask first.",
)

prefix_rule(
    pattern = [["curl", "wget", "ssh", "scp", "rsync"]],
    decision = "prompt",
    justification = "Network and remote-host commands cross the workspace trust boundary.",
)

prefix_rule(
    pattern = [["docker", "kubectl", "aws", "gcloud", "az", "terraform"]],
    decision = "prompt",
    justification = "Infrastructure and cloud CLIs can affect external resources.",
)

prefix_rule(
    pattern = ["git", ["add", "commit", "stash", "switch", "checkout", "merge", "rebase", "push", "reset", "clean", "tag"]],
    decision = "prompt",
    justification = "Git mutation, publish, and history operations should be user-visible.",
)

prefix_rule(
    pattern = ["rm"],
    decision = "prompt",
    justification = "File deletion should be user-visible unless a narrower project rule allows it.",
)

prefix_rule(
    pattern = ["sudo"],
    decision = "forbidden",
    justification = "Do not escalate privileges from the coding agent; ask the user for a manual administrative step.",
)

prefix_rule(
    pattern = ["rm", "-rf", "/"],
    decision = "forbidden",
    justification = "Refuse root deletion. Use a narrow workspace path and ask for approval if deletion is needed.",
)

prefix_rule(
    pattern = ["rm", "-rf", "~"],
    decision = "forbidden",
    justification = "Refuse home-directory deletion. Use a narrow workspace path and ask for approval if deletion is needed.",
)

prefix_rule(
    pattern = ["chmod", "-R", "777"],
    decision = "forbidden",
    justification = "Broad world-writable permission changes are unsafe. Use a narrow chmod target manually.",
)
