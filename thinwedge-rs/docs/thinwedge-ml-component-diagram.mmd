flowchart TD
    user[User / ThinWedge Operator]
    tui[ThinWedge TUI / App Server]
    tools[Dynamic Tool Namespaces]

    subgraph tool_ns[Tool Commands]
        sm_list["statisticalmodels.list"]
        sm_get["statisticalmodels.get"]
        sm_submit["statisticalmodels.submitJob"]
        sm_jobs["statisticalmodels.listJobs / getJob"]
        sm_evals["statisticalmodels.listEvals / getEval"]
        te_list["trainingenvironments.list"]
        te_get["trainingenvironments.get"]
        te_launch["trainingenvironments.launch"]
        te_attach["trainingenvironments.attach"]
        te_stop["trainingenvironments.stop"]
        cc_llm["llmcosts.listModels / getModel / compareModels"]
        cc_aws["infracosts.describeAwsServices / searchAwsServices / searchAwsPriceListAttributeNames / searchAwsPriceListAttributeValues / getAwsCostAndUsage / getAwsDimensionValues / getAwsCostForecast / getAwsAnomalies / queryAwsByService / queryAwsByAccount / listBillingViews / getAwsProducts / getAwsVmPrice / estimateAwsBoq"]
    end

    subgraph dispatcher[ThinWedge ML Dispatcher]
        spec["thinwedge_ml/spec.rs"]
        costs["thinwedge_ml/cost_context.rs"]
        exec["thinwedge_ml/execution.rs"]
        storage["thinwedge_ml/storage.rs"]
        types["thinwedge_ml/types.rs"]
    end

    subgraph local_state[Local Filesystem State under THINWEDGE_HOME/thinwedge/ml]
        models["statisticalmodels.json"]
        envs["trainingenvironments.json"]
        jobs["jobs/*.json"]
        evals["evals/*.json"]
        runtime["runtime/*.json"]
        artifacts["artifacts/**"]
        sessions["environments/*.json"]
    end

    subgraph scripts[ThinWedge Script Package]
        common["scripts/thinwedge-ml/common.sh"]
        train["train.sh"]
        batch["batch_infer.sh"]
        launch["launch.sh"]
        attach["attach.sh"]
        stop["stop.sh"]
        seed["seed-fixtures.sh"]
        smoke["smoke-test.sh"]
    end

    subgraph model_repo[Statistical Model Repository]
        repo_root["Repository Root"]
        repo_cfg["config.yaml / config files"]
        repo_entry["scripts/train.sh / scripts/batch_infer.sh wrappers"]
        generated["Generated Model Source Files"]
    end

    subgraph env_repo[Training Environment Repository]
        env_root["Environment Repo Root"]
        env_entry["ops/launch.sh / attach.sh / stop.sh wrappers"]
        env_workdir["workingDirectory"]
    end

    subgraph inference[Inference Provider Path]
        provider_meta["Inference Target Metadata\nproviderId / modelName / baseUrl / apiKeyEnv"]
        openrouter["OpenRouter API\n/models\n/chat/completions"]
    end

    subgraph cost_context[Cost Context APIs]
        aa["Artificial Analysis API\n/api/v2/data/llms/models"]
        aws["AWS Price List Query API\nDescribeServices / GetProducts"]
        ce["AWS Cost Explorer\nGetCostAndUsage / GetDimensionValues / GetCostForecast / GetAnomalies"]
        billing["AWS Billing\nListBillingViews"]
    end

